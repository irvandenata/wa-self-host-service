            "key": "value",
            "value": "{{adminApiKey}}",
            "type": "string"
          },
          {
            "key": "key",
            "value": "X-API-Key",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "item": [
